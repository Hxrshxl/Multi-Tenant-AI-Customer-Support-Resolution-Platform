# Normalise line endings so a cross-platform team does not fight the diff.
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.ps1  text eol=crlf
*.bat  text eol=crlf
*.cmd  text eol=crlf

# Lockfiles are generated — collapse them in diffs.
requirements.lock.txt linguist-generated=true
.secrets.baseline     linguist-generated=true
