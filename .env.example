# Copy to .env and adjust. Never commit .env — it is gitignored.
#
# Every variable without a default is REQUIRED. Starting the app or running
# `python -m app.cli check` without one fails immediately and names it.
#
# These values assume you are running the app on your host against the
# containers from docker-compose.yml. When the app itself runs inside compose,
# the compose file overrides DATABASE_URL and REDIS_URL with container
# hostnames, so you do not need to change anything here.

# --- Runtime ---------------------------------------------------------------
# One of: local | test | staging | production      (default: local)
APP_ENV=local
# One of: DEBUG | INFO | WARNING | ERROR           (default: INFO)
LOG_LEVEL=INFO

# --- Data stores (required) ------------------------------------------------
# Must match POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB in docker-compose.yml.
DATABASE_URL=postgresql://support:support@localhost:5433/support

REDIS_URL=redis://localhost:6379/0

# --- Tenancy ---------------------------------------------------------------
# Slug of the tenant used by local development and the seed data.
DEFAULT_TENANT_SLUG=acme
